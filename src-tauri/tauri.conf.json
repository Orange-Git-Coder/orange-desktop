{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "orange-desktop",
    "version": "0.1.0",
    "identifier": "com.orange.desktop",
    "build": {
        "beforeDevCommand": "deno task dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "deno task build",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "title": "🍊 Orange Desktop",
                "width": 1000,
                "height": 650
            }
        ],
        "security": {
            "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data: asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost"
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ]
    }
}
